{
  "manifest_version": 3,
  "name": "B站专注模式 · Bilibili Focus",
  "version": "1.0.0",
  "description": "一键隐藏 B 站视频页的推荐流、广告、评论等干扰内容，只留课程与播放器；支持点选删除任意元素。",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "切换 B站专注模式"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "css": ["src/focus.css"],
      "js": ["src/early.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
